@prefix cmns-doc: <https://www.omg.org/spec/Commons/Documents/> .
@prefix cmns-org: <https://www.omg.org/spec/Commons/Organizations/> .
@prefix cmns-pts: <https://www.omg.org/spec/Commons/PartiesAndSituations/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-be-fct-fct: <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/> .
@prefix fibo-fbc-fct-usjrga: <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/NorthAmericanEntities/USRegulatoryAgencies/> .
@prefix fibo-fbc-fi-stl: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/Settlement/> .
@prefix fibo-fnd-aap-ppl: <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/> .
@prefix fibo-loan-spc-crd: <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansSpecific/CardAccounts/> .
@prefix iso20022: <urn:iso:std:iso:20022:tech:xsd:> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix pay: <https://ontology.example.com/payments/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pay:Chunk a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Chunk" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:part_of ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:id ] ;
    skos:definition "A passage of a document. Its text and embedding live in OpenSearch; the stub in Neptune links it to the entities it mentions." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:example "visa-vamp-2026#c04" ;
    pay:id_rule "{doc_slug}#{chunk}" ;
    pay:lives_in "search" ;
    pay:no_standard "A passage of an indexed document is this platform's own idea." ;
    pay:owner "core" ;
    pay:search_index "chunks" .

pay:FeeCollection a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "FeeCollection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[A-Z]{3}$" ] ) ] ;
            owl:onProperty pay:currency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:currency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:under ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:collected_from ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:amount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:collected_at ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:id ] ;
    skos:altLabel "assessments",
        "network billing",
        "network fees" ;
    skos:closeMatch iso20022:cafc.001.001.04 ;
    skos:definition "The network collecting fees from a member, an issuer or an acquirer, such as its monthly assessments." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:graph_load "never" ;
    pay:id_rule "fc:{collection_id}" ;
    pay:lives_in "warehouse" ;
    pay:owner "settlement" .

pay:MonitoringNotice a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "MonitoringNotice" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^\\d{4}-\\d{2}$" ] ) ] ;
            owl:onProperty pay:month ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:tier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:ratio ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:month ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:identifies ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:id ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:program ] ;
    skos:altLabel "ECM notice",
        "VAMP notice",
        "program identification" ;
    skos:definition "A card network identifying a merchant in one of its monitoring programs for a month, such as Visa's VAMP, with the tier and the ratio it measured." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:example "Sunset Tickets m:10442, VAMP, 2026-08, excessive, ratio 1.65%" ;
    pay:id_rule "mon:{program}:{merchant_id}:{month}" ;
    pay:lives_in "graph" ;
    pay:no_standard "Monitoring programs are card network rules, with no ISO 20022 message or FIBO concept of their own." ;
    pay:owner "disputes" .

pay:Reconciliation a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Reconciliation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:difference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[A-Z]{3}$" ] ) ] ;
            owl:onProperty pay:currency ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:matched ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:reconciled_at ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:reconciles ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:id ] ;
    skos:altLabel "recon",
        "settlement reconciliation" ;
    skos:closeMatch iso20022:caad.005.001.05 ;
    skos:definition "A member checking its totals for a settlement against the network's, and recording any difference." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:graph_load "never" ;
    pay:id_rule "rec:{reconciliation_id}" ;
    pay:lives_in "warehouse" ;
    pay:owner "settlement" .

pay:acts_as a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "acts_as" ;
    rdfs:range pay:PartyRole ;
    skos:definition "A party plays a role." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:has_evidence a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "has_evidence" ;
    rdfs:range pay:Document ;
    skos:definition "Documents sent as evidence." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:mentions a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "mentions" ;
    rdfs:range pay:Any ;
    skos:definition "Anything a chunk names, such as a merchant, a reason code or a dispute, so its text links to the graph." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:seen_at a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "seen_at" ;
    rdfs:range pay:Merchant ;
    skos:definition "A summary edge, rebuilt daily from Snowflake: the device made authorizations at the merchant. It carries auths, first_seen and last_seen, so risk walks don't need every authorization in the graph (decision 2)." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:edge_properties "auths:Long, first_seen:DateTime, last_seen:DateTime" .

pay:Adjustment a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Adjustment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[A-Z]{3}$" ] ) ] ;
            owl:onProperty pay:currency ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:adjusts ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:adjusted_at ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:amount ],
        pay:PaymentEvent ;
    skos:altLabel "clearing adjustment",
        "correction" ;
    skos:definition "A correction to a capture after it cleared, such as a changed amount, made under the network's rules." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:id_rule "adj:{adjustment_id}" ;
    pay:lives_in "warehouse" ;
    pay:no_standard "ISO 20022's Amendment (cain.020) reports a corrected message, not a change to a settled amount. Networks run adjustments under their own rules." ;
    pay:owner "settlement" .

pay:Any a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Any" ;
    skos:definition "Any entity with an ID. A relationship whose range is Any can point at a node of any class, as a chunk's MENTIONS does. Not a node itself." ;
    skos:exactMatch linkml:Any ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:Arbitration a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Arbitration" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:responds_to ],
        pay:DisputeEvent ;
    skos:altLabel "arbitration case" ;
    skos:definition "Either side asking the card network to decide a dispute that pre-arbitration didn't settle. The network's ruling is binding." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:id_rule "arb:{arbitration_id}" ;
    pay:lives_in "graph" ;
    pay:no_standard "Arbitration is a card network rule, with no ISO 20022 message or FIBO concept of its own." ;
    pay:owner "disputes" .

pay:BinRange a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "BinRange" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:prefix ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:funding_source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:assigned_to ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:country ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[A-Z]{2}$" ] ) ] ;
            owl:onProperty pay:country ] ;
    skos:altLabel "BIN",
        "IIN" ;
    skos:closeMatch fibo-fbc-fct-usjrga:IssuerIdentificationNumber ;
    skos:definition "The range of card numbers a bank issues from. A node rather than a string, so authorizations can be grouped by it." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:id_rule "bin:{prefix}" ;
    pay:lives_in "graph" ;
    pay:owner "authorization" .

pay:Card a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Card" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:network ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:held_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:in_bin_range ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:id ] ;
    skos:altLabel "PAN",
        "token" ;
    skos:closeMatch fibo-loan-spc-crd:PaymentCard ;
    skos:definition "A payment card, identified by a token rather than its number." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:example "card:tk_1a3" ;
    pay:id_rule "card:{token}" ;
    pay:lives_in "graph" ;
    pay:owner "core" .

pay:Chargeback a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Chargeback" ;
    dcterms:title "Chargeback" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty pay:opened_at ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:currency ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:disputes ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty pay:amount ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:opened_at ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pay:has_reason ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:amount ],
        pay:DisputeEvent ;
    skos:altLabel "CB",
        "chargeback case" ;
    skos:closeMatch iso20022:cain.027.001.04 ;
    skos:definition "A dispute event in which the issuer, through the card network, reverses all or part of a captured transaction for the cardholder." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:example "cb:1001, Aug 19, reason 10.4, $42.50" ;
    pay:id_rule "cb:{chargeback_id}" ;
    pay:lives_in "graph" ;
    pay:owner "disputes" .

pay:ClearingBatch a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ClearingBatch" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:sent_at ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:id ] ;
    skos:altLabel "batch",
        "clearing file",
        "settlement file" ;
    skos:closeMatch iso20022:caad.003.001.04 ;
    skos:definition "A batch of captures sent for clearing and settlement in one exchange, such as an acquirer's clearing file." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:graph_load "never" ;
    pay:id_rule "batch:{batch_id}" ;
    pay:lives_in "warehouse" ;
    pay:owner "settlement" .

pay:Device a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Device" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:id ] ;
    skos:definition "A phone, browser or terminal an authorization came from." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:id_rule "dev:{device_id}" ;
    pay:lives_in "graph" ;
    pay:no_standard "ISO 20022 describes the point of interaction inside card messages, with no identifier of its own. FIBO has no device." ;
    pay:owner "risk" .

pay:DisputeOutcome a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "DisputeOutcome" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:responds_to ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:won_by ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:disputes ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:closure ],
        pay:DisputeEvent ;
    skos:altLabel "case closure",
        "dispute resolution" ;
    skos:definition "The event that closes a dispute: which side won, how it ended, and the amount that finally went back to the cardholder. It answers the dispute's last step, and links to the disputed capture, as the chargeback does." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:id_rule "out:{outcome_id}" ;
    pay:lives_in "graph" ;
    pay:no_standard "The ISO 20022 card messages carry the steps of a dispute, but none stands for its outcome. Networks record it in their own case systems." ;
    pay:owner "disputes" .

pay:FraudReport a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "FraudReport" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:reported_at ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:reports ],
        pay:PaymentEvent ;
    skos:altLabel "SAFE report",
        "TC40" ;
    skos:closeMatch iso20022:cafr.001.001.04 ;
    skos:definition "An issuer reporting an authorization as fraud to the network." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:id_rule "fr:{report_id}" ;
    pay:lives_in "graph" ;
    pay:owner "risk" .

pay:Organization a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Organization" ;
    rdfs:subClassOf pay:Party ;
    skos:closeMatch cmns-org:Organization ;
    skos:definition "A company or institution. One bank is one Organization, however many roles it plays." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:example "First Bay Bank" ;
    pay:id_rule "org:{org_id}" ;
    pay:lives_in "graph" ;
    pay:owner "core" .

pay:Payout a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Payout" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[A-Z]{3}$" ] ) ] ;
            owl:onProperty pay:currency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:currency ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pay:funds ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:amount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:reserve_amount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:paid_at ],
        pay:PaymentEvent ;
    skos:altLabel "deposit",
        "merchant funding",
        "remittance" ;
    skos:definition "The acquirer paying a merchant for its settled captures, less fees and any amount held back in reserve." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:id_rule "po:{payout_id}" ;
    pay:lives_in "warehouse" ;
    pay:no_standard "Acquirers pay merchants by ordinary bank transfer, outside the card messages, and FIBO has no merchant funding concept." ;
    pay:owner "settlement" .

pay:Person a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Person" ;
    rdfs:subClassOf pay:Party ;
    skos:closeMatch fibo-fnd-aap-ppl:Person ;
    skos:definition "An individual, such as a cardholder." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:example "Maya" ;
    pay:id_rule "person:{person_id}" ;
    pay:lives_in "graph" ;
    pay:owner "core" .

pay:PreArbitration a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "PreArbitration" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:responds_to ],
        pay:DisputeEvent ;
    skos:altLabel "pre-arb" ;
    skos:definition "Issuer challenges the merchant's response before arbitration." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:id_rule "parb:{pre_arbitration_id}" ;
    pay:lives_in "graph" ;
    pay:no_standard "Pre-arbitration is a card network rule, with no ISO 20022 message or FIBO concept of its own." ;
    pay:owner "disputes" .

pay:ReasonCode a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ReasonCode" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:category ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:network ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:code ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:id ] ;
    skos:altLabel "dispute reason" ;
    skos:definition "A network's reason for a dispute. A node, so chargebacks and the documents that explain the code meet at one place." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:code_list "VisaReasonCode" ;
    pay:example "rc:visa:10.4, Other Fraud: Card-Absent Environment" ;
    pay:id_rule "rc:{network}:{code}" ;
    pay:lives_in "graph" ;
    pay:no_standard "Each card network publishes its own dispute reason codes; no ISO list covers them." ;
    pay:owner "disputes" .

pay:Refund a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Refund" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[A-Z]{3}$" ] ) ] ;
            owl:onProperty pay:currency ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:refunds ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:amount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:refunded_at ],
        pay:PaymentEvent ;
    skos:altLabel "credit" ;
    skos:definition "The merchant returning all or part of a captured amount." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:id_rule "rf:{refund_id}" ;
    pay:lives_in "warehouse" ;
    pay:no_standard "ISO 20022 sends a refund as a financial message with a refund transaction type, so no message stands for refunds alone." ;
    pay:owner "settlement" .

pay:Representment a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Representment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:responds_to ],
        pay:DisputeEvent ;
    skos:altLabel "merchant response",
        "second presentment" ;
    skos:definition "The merchant's response to a chargeback, with its evidence." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:id_rule "rep:{representment_id}" ;
    pay:lives_in "graph" ;
    pay:no_standard "ISO 20022's chargeback response (cain.028) answers a chargeback, but whether it carries the merchant's evidence isn't confirmed yet." ;
    pay:owner "disputes" .

pay:ResponseCode a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ResponseCode" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:code ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:id ] ;
    skos:definition "The issuer's answer code on an authorization, such as approved or declined." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:id_rule "resp:{code}" ;
    pay:lives_in "graph" ;
    pay:no_standard "Response codes come from ISO 8583 and each network's rules, which publish no identifiers to map to." ;
    pay:owner "authorization" .

pay:RetrievalRequest a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "RetrievalRequest" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:disputes ],
        pay:DisputeEvent ;
    skos:altLabel "copy request",
        "request for copy" ;
    skos:closeMatch iso20022:cain.021.001.04 ;
    skos:definition "The issuer asking the acquirer for the original transaction details, often before it decides whether to dispute." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:id_rule "rr:{retrieval_id}" ;
    pay:lives_in "graph" ;
    pay:owner "disputes" .

pay:Reversal a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Reversal" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:currency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:reversed_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[A-Z]{3}$" ] ) ] ;
            owl:onProperty pay:currency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:amount ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:reverses ],
        pay:PaymentEvent ;
    skos:altLabel "authorization reversal" ;
    skos:closeMatch iso20022:cain.005.001.05 ;
    skos:definition "The acquirer cancelling all or part of an authorization, so the issuer releases the hold on the cardholder's funds." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:id_rule "rev:{reversal_id}" ;
    pay:lives_in "warehouse" ;
    pay:owner "authorization" .

pay:acquired_by a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "acquired_by" ;
    rdfs:range pay:Acquirer ;
    skos:definition "A merchant's acquiring bank." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:adjusted_at a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "adjusted_at" ;
    rdfs:range linkml:Datetime ;
    skos:definition "When the adjustment was made." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:adjusts a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "adjusts" ;
    rdfs:range pay:Capture ;
    skos:definition "The capture an adjustment corrects." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:approved_amount a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "approved_amount" ;
    rdfs:range linkml:Decimal ;
    skos:definition "The amount the issuer approved, when less than the amount requested: a partial approval." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:assigned_to a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "assigned_to" ;
    rdfs:range pay:Issuer ;
    skos:definition "The issuer a BIN range belongs to." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:at_merchant a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "at_merchant" ;
    rdfs:range pay:Merchant ;
    skos:definition "Where an authorization was requested." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:authenticated_at a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "authenticated_at" ;
    rdfs:range linkml:Datetime ;
    skos:definition "When the cardholder was authenticated." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:authenticated_by a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "authenticated_by" ;
    rdfs:range pay:Authentication ;
    skos:definition "The authentication an authorization relied on." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:authentication_result a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "authentication_result" ;
    rdfs:range pay:AuthenticationResult ;
    skos:definition "How an authentication ended, as EMV 3-D Secure's final transaction status reports it." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:authorization_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "authorization_type" ;
    rdfs:range pay:AuthorizationType ;
    skos:definition "Whether an authorization's amount is final, an estimate, or an increase to an earlier estimate." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:authorized_at a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "authorized_at" ;
    rdfs:range linkml:Datetime ;
    skos:definition "When the issuer answered." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:captured_at a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "captured_at" ;
    rdfs:range linkml:Datetime ;
    skos:definition "When the merchant claimed the funds." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:captures a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "captures" ;
    rdfs:range pay:Authorization ;
    skos:definition "The authorization a capture claims funds for." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:category a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "category" ;
    rdfs:range pay:DisputeCategory ;
    skos:definition "The kind of dispute a reason code stands for, the same across networks, so chargebacks can be grouped without knowing each network's codes." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:challenged a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "challenged" ;
    rdfs:range linkml:Boolean ;
    skos:definition "Whether the issuer challenged the cardholder, such as with a one-time code, rather than letting the payment through without friction." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:channel a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "channel" ;
    rdfs:range pay:Channel ;
    skos:definition "Whether the card was present." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:closure a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "closure" ;
    rdfs:range pay:DisputeClosure ;
    skos:definition "How a dispute ended." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:collected_at a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "collected_at" ;
    rdfs:range linkml:Datetime ;
    skos:definition "When the network collected the fees." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:collected_from a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "collected_from" ;
    rdfs:range pay:PartyRole ;
    skos:definition "The member the fees were collected from, an issuer or an acquirer." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:conversion_rate a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "conversion_rate" ;
    rdfs:range linkml:Decimal ;
    skos:definition "The rate that converted a capture's amount into its settlement's currency, when the two differ." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:credential a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "credential" ;
    rdfs:range pay:Credential ;
    skos:definition "What stood in for the card number in an authorization." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:decided_by a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "decided_by" ;
    rdfs:range pay:Decider ;
    skos:definition "Who answered the authorization: the issuer, or stand-in processing answering for an issuer that couldn't." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:difference a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "difference" ;
    rdfs:range linkml:Decimal ;
    skos:definition "The amount by which the totals differed." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:fee_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "fee_type" ;
    rdfs:range pay:FeeType ;
    skos:definition "What kind of fee a program sets." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:from_device a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "from_device" ;
    rdfs:range pay:Device ;
    skos:definition "The device an authorization came from." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:funding_source a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "funding_source" ;
    rdfs:range pay:FundingSource ;
    skos:definition "Where the money behind the cards in a BIN range comes from, as the network's BIN table reports it." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:funds a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "funds" ;
    rdfs:range pay:Capture ;
    skos:definition "The captures a payout pays the merchant for." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:has_reason a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "has_reason" ;
    rdfs:range pay:ReasonCode ;
    skos:definition "The network reason codes behind a dispute." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:has_response a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "has_response" ;
    rdfs:range pay:ResponseCode ;
    skos:definition "The issuer's answer to an authorization." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:held_by a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "held_by" ;
    rdfs:range pay:Cardholder ;
    skos:definition "Who a card is issued to." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:identifies a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "identifies" ;
    rdfs:range pay:Merchant ;
    skos:definition "The merchant a monitoring notice identifies." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:in_batch a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "in_batch" ;
    rdfs:range pay:ClearingBatch ;
    skos:definition "The batch that carried a capture to the network." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:in_bin_range a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "in_bin_range" ;
    rdfs:range pay:BinRange ;
    skos:definition "The BIN range a card's number falls in." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:increments a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "increments" ;
    rdfs:range pay:Authorization ;
    skos:definition "The earlier authorization an incremental authorization adds to." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:initiated_by a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "initiated_by" ;
    rdfs:range pay:Initiator ;
    skos:definition "Who started the payment, under the networks' stored-credential rules: the cardholder, or the merchant using a card it keeps on file." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:interchange_fee a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "interchange_fee" ;
    rdfs:range linkml:Decimal ;
    skos:definition "The interchange the capture paid, in its settlement's currency. The amount stays in Snowflake; the program it qualified for is a node." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:kind a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "kind" ;
    rdfs:range pay:DocumentKind ;
    skos:definition "What sort of document it is." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:matched a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "matched" ;
    rdfs:range linkml:Boolean ;
    skos:definition "Whether the member's totals matched the network's." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:paid_at a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "paid_at" ;
    rdfs:range linkml:Datetime ;
    skos:definition "When the acquirer paid the merchant." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:part_of a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "part_of" ;
    rdfs:range pay:Document ;
    skos:definition "The document a chunk comes from." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:prefix a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "prefix" ;
    skos:definition "The leading digits every card in the range shares." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:program a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "program" ;
    rdfs:range pay:MonitoringProgram ;
    skos:definition "The network monitoring program." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:qualifies_for a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "qualifies_for" ;
    rdfs:range pay:FeeProgram ;
    skos:definition "The interchange program a capture qualified for." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:ratio a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ratio" ;
    rdfs:range linkml:Decimal ;
    skos:definition "The ratio the program measured for the month, as a fraction (0.0165 is 1.65%)." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:reconciled_at a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reconciled_at" ;
    rdfs:range linkml:Datetime ;
    skos:definition "When the totals were checked." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:reconciles a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reconciles" ;
    rdfs:range pay:Settlement ;
    skos:definition "The settlement whose totals were checked." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:refunded_at a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "refunded_at" ;
    rdfs:range linkml:Datetime ;
    skos:definition "When the refund was made." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:refunds a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "refunds" ;
    rdfs:range pay:Capture ;
    skos:definition "The capture a refund returns money from." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:reported_at a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reported_at" ;
    rdfs:range linkml:Datetime ;
    skos:definition "When the fraud was reported." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:reports a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reports" ;
    rdfs:range pay:Authorization ;
    skos:definition "The authorization a fraud report is about." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:reserve_amount a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reserve_amount" ;
    rdfs:range linkml:Decimal ;
    skos:definition "The amount held back from a payout into the merchant's reserve; negative when the acquirer releases reserve." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:respond_by a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "respond_by" ;
    rdfs:range linkml:Datetime ;
    skos:definition "When the other side must answer this step by, under the network's rules for the stage. Missing it decides the dispute against that side." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:reversed_at a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reversed_at" ;
    rdfs:range linkml:Datetime ;
    skos:definition "When the acquirer sent the reversal." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:reverses a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reverses" ;
    rdfs:range pay:Authorization ;
    skos:definition "The authorization a reversal cancels." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:sent_at a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sent_at" ;
    rdfs:range linkml:Datetime ;
    skos:definition "When the batch was sent." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:settled_at a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "settled_at" ;
    rdfs:range linkml:Datetime ;
    skos:definition "When the funds moved." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:settles a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "settles" ;
    rdfs:range pay:Capture ;
    skos:definition "The captures a settlement pays out." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:standing_instruction a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "standing_instruction" ;
    rdfs:range pay:StandingInstruction ;
    skos:definition "The agreement a merchant-initiated payment follows, such as a subscription." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:tier a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "tier" ;
    rdfs:range pay:MonitoringTier ;
    skos:definition "The program's tier the merchant was identified in, where the program has tiers." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:under a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "under" ;
    rdfs:range pay:FeeProgram ;
    skos:definition "The fee program a collection charges." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:with_card a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "with_card" ;
    rdfs:range pay:Card ;
    skos:definition "The card an authorization used." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:won_by a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "won_by" ;
    rdfs:range pay:DisputeSide ;
    skos:definition "The side a dispute ended in favor of." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:Acquirer a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Acquirer" ;
    rdfs:subClassOf pay:PartyRole ;
    skos:definition "The bank that signs up merchants and claims funds for them." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:example "Coastal Acquiring" ;
    pay:id_rule "acq:{acquirer_id}" ;
    pay:lives_in "graph" ;
    pay:no_standard "FIBO has no acquirer. ISO 20022 names the acquirer only as a party inside card messages, with no identifier of its own." ;
    pay:owner "core" .

pay:Authentication a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Authentication" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:authentication_result ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:challenged ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:authenticated_at ],
        pay:PaymentEvent ;
    skos:altLabel "3-D Secure",
        "3DS",
        "cardholder authentication" ;
    skos:definition "The issuer checking that the cardholder is who they say, before an authorization, such as a 3-D Secure attempt." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:id_rule "authn:{authentication_id}" ;
    pay:lives_in "warehouse" ;
    pay:no_standard "3-D Secure is an EMVCo protocol. No ISO 20022 message or FIBO concept stands for an authentication on its own." ;
    pay:owner "authorization" .

<https://ontology.example.com/payments/AuthenticationResult#attempted> a owl:NamedIndividual,
        pay:AuthenticationResult ;
    rdfs:label "attempted" ;
    skos:definition "Not verified, but proof of an attempt is provided (status A)." .

<https://ontology.example.com/payments/AuthenticationResult#authenticated> a owl:NamedIndividual,
        pay:AuthenticationResult ;
    rdfs:label "authenticated" ;
    skos:definition "The cardholder was verified (status Y)." .

<https://ontology.example.com/payments/AuthenticationResult#not_authenticated> a owl:NamedIndividual,
        pay:AuthenticationResult ;
    rdfs:label "not_authenticated" ;
    skos:definition "Not verified, and the transaction is denied (status N)." .

<https://ontology.example.com/payments/AuthenticationResult#rejected> a owl:NamedIndividual,
        pay:AuthenticationResult ;
    rdfs:label "rejected" ;
    skos:definition "The issuer rejected it and asks that no authorization be attempted (status R)." .

<https://ontology.example.com/payments/AuthenticationResult#unavailable> a owl:NamedIndividual,
        pay:AuthenticationResult ;
    rdfs:label "unavailable" ;
    skos:definition "It couldn't be performed, for a technical or other reason (status U)." .

<https://ontology.example.com/payments/AuthorizationType#estimated> a owl:NamedIndividual,
        pay:AuthorizationType ;
    rdfs:label "estimated" ;
    skos:definition "The final amount isn't known yet, such as at a hotel or car rental. Mastercard calls it a preauthorization." .

<https://ontology.example.com/payments/AuthorizationType#final> a owl:NamedIndividual,
        pay:AuthorizationType ;
    rdfs:label "final" ;
    skos:definition "The amount is final, and the payment will be captured for it." .

<https://ontology.example.com/payments/AuthorizationType#incremental> a owl:NamedIndividual,
        pay:AuthorizationType ;
    rdfs:label "incremental" ;
    skos:definition "An increase to an earlier estimated authorization." .

<https://ontology.example.com/payments/AuthorizationType#undefined> a owl:NamedIndividual,
        pay:AuthorizationType ;
    rdfs:label "undefined" ;
    skos:definition "Neither final nor an estimate, in Mastercard's terms." .

pay:Cardholder a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Cardholder" ;
    rdfs:subClassOf pay:PartyRole ;
    skos:closeMatch fibo-loan-spc-crd:Cardholder ;
    skos:definition "The person a card is issued to." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:example "Maya" ;
    pay:id_rule "ch:{cardholder_id}" ;
    pay:lives_in "graph" ;
    pay:owner "core" .

<https://ontology.example.com/payments/Channel#card_not_present> a owl:NamedIndividual,
        pay:Channel ;
    rdfs:label "card_not_present" .

<https://ontology.example.com/payments/Channel#card_present> a owl:NamedIndividual,
        pay:Channel ;
    rdfs:label "card_present" .

<https://ontology.example.com/payments/Credential#card_on_file_token> a owl:NamedIndividual,
        pay:Credential ;
    rdfs:label "card_on_file_token" ;
    skos:definition "A network token a merchant or processor keeps on file." .

<https://ontology.example.com/payments/Credential#pan> a owl:NamedIndividual,
        pay:Credential ;
    rdfs:label "pan" ;
    skos:definition "The card number itself." .

<https://ontology.example.com/payments/Credential#wallet_token> a owl:NamedIndividual,
        pay:Credential ;
    rdfs:label "wallet_token" ;
    skos:definition "A network token held in a digital wallet, such as a phone's." .

<https://ontology.example.com/payments/Decider#issuer> a owl:NamedIndividual,
        pay:Decider ;
    rdfs:label "issuer" ;
    skos:definition "The issuer, or its processor, decided." .

<https://ontology.example.com/payments/Decider#network_stand_in> a owl:NamedIndividual,
        pay:Decider ;
    rdfs:label "network_stand_in" ;
    skos:definition "The network's stand-in processing answered for the issuer, such as Visa's STIP." .

<https://ontology.example.com/payments/Decider#processor_stand_in> a owl:NamedIndividual,
        pay:Decider ;
    rdfs:label "processor_stand_in" ;
    skos:definition "The issuer's processor answered with its own stand-in rules." .

<https://ontology.example.com/payments/DisputeCategory#authorization> a owl:NamedIndividual,
        pay:DisputeCategory ;
    rdfs:label "authorization" ;
    skos:definition "The transaction wasn't properly authorized (Visa 11.x)." .

<https://ontology.example.com/payments/DisputeCategory#consumer_dispute> a owl:NamedIndividual,
        pay:DisputeCategory ;
    rdfs:label "consumer_dispute" ;
    skos:definition "The cardholder disputes what they got, such as goods not received (Visa 13.x)." .

<https://ontology.example.com/payments/DisputeCategory#fraud> a owl:NamedIndividual,
        pay:DisputeCategory ;
    rdfs:label "fraud" ;
    skos:definition "The cardholder didn't take part in the transaction (Visa 10.x)." .

<https://ontology.example.com/payments/DisputeCategory#processing_error> a owl:NamedIndividual,
        pay:DisputeCategory ;
    rdfs:label "processing_error" ;
    skos:definition "The transaction was processed wrongly, such as late or twice (Visa 12.x)." .

<https://ontology.example.com/payments/DisputeClosure#accepted> a owl:NamedIndividual,
        pay:DisputeClosure ;
    rdfs:label "accepted" ;
    skos:definition "One side accepted the other's last step." .

<https://ontology.example.com/payments/DisputeClosure#ruled> a owl:NamedIndividual,
        pay:DisputeClosure ;
    rdfs:label "ruled" ;
    skos:definition "The card network ruled in arbitration." .

<https://ontology.example.com/payments/DisputeClosure#timed_out> a owl:NamedIndividual,
        pay:DisputeClosure ;
    rdfs:label "timed_out" ;
    skos:definition "A side missed its deadline, so the dispute went against it." .

<https://ontology.example.com/payments/DisputeClosure#withdrawn> a owl:NamedIndividual,
        pay:DisputeClosure ;
    rdfs:label "withdrawn" ;
    skos:definition "The issuer withdrew the dispute, often because its cardholder did." .

<https://ontology.example.com/payments/DisputeSide#acquirer> a owl:NamedIndividual,
        pay:DisputeSide ;
    rdfs:label "acquirer" ;
    skos:definition "The acquirer, for its merchant." .

<https://ontology.example.com/payments/DisputeSide#issuer> a owl:NamedIndividual,
        pay:DisputeSide ;
    rdfs:label "issuer" ;
    skos:definition "The issuer, for its cardholder." .

pay:Document a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Document" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:kind ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:id ] ;
    skos:closeMatch cmns-doc:Document ;
    skos:definition "A network rule book, runbook or piece of evidence. Its text lives in search; Neptune keeps a stub." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:example "visa-vamp-2026" ;
    pay:id_rule "{doc_slug}" ;
    pay:lives_in "search" ;
    pay:owner "core" .

<https://ontology.example.com/payments/DocumentKind#evidence> a owl:NamedIndividual,
        pay:DocumentKind ;
    rdfs:label "evidence" .

<https://ontology.example.com/payments/DocumentKind#network_rules> a owl:NamedIndividual,
        pay:DocumentKind ;
    rdfs:label "network_rules" .

<https://ontology.example.com/payments/DocumentKind#runbook> a owl:NamedIndividual,
        pay:DocumentKind ;
    rdfs:label "runbook" .

pay:FeeProgram a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "FeeProgram" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:fee_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:network ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:code ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:id ] ;
    skos:altLabel "fee schedule",
        "interchange category",
        "interchange program" ;
    skos:definition "A fee a network publishes, such as an interchange category a capture qualifies for. A node, so captures and the fees charged meet at one place; the amounts stay in Snowflake (decision 2)." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:id_rule "fee:{network}:{code}" ;
    pay:lives_in "graph" ;
    pay:no_standard "Each network publishes its own interchange programs and fees; no ISO list or FIBO concept covers them." ;
    pay:owner "settlement" .

<https://ontology.example.com/payments/FeeType#interchange> a owl:NamedIndividual,
        pay:FeeType ;
    rdfs:label "interchange" ;
    skos:definition "Paid by the acquirer to the issuer on each capture." .

<https://ontology.example.com/payments/FeeType#network_fee> a owl:NamedIndividual,
        pay:FeeType ;
    rdfs:label "network_fee" ;
    skos:definition "Charged by the network to its members, such as assessments." .

<https://ontology.example.com/payments/FundingSource#credit> a owl:NamedIndividual,
        pay:FundingSource ;
    rdfs:label "credit" ;
    skos:closeMatch fibo-loan-spc-crd:CreditCard ;
    skos:definition "A line of credit." .

<https://ontology.example.com/payments/FundingSource#debit> a owl:NamedIndividual,
        pay:FundingSource ;
    rdfs:label "debit" ;
    skos:closeMatch fibo-loan-spc-crd:DebitCard ;
    skos:definition "A deposit account." .

<https://ontology.example.com/payments/FundingSource#prepaid> a owl:NamedIndividual,
        pay:FundingSource ;
    rdfs:label "prepaid" ;
    skos:definition "Funds loaded onto the card in advance." .

<https://ontology.example.com/payments/Initiator#cardholder> a owl:NamedIndividual,
        pay:Initiator ;
    rdfs:label "cardholder" ;
    skos:definition "The cardholder took part, such as at a checkout." .

<https://ontology.example.com/payments/Initiator#merchant> a owl:NamedIndividual,
        pay:Initiator ;
    rdfs:label "merchant" ;
    skos:definition "The merchant charged a card it keeps on file, under an agreement with the cardholder." .

pay:Issuer a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Issuer" ;
    rdfs:subClassOf pay:PartyRole ;
    skos:closeMatch fibo-loan-spc-crd:IssuingFinancialInstitution ;
    skos:definition "The bank that issues cards and approves or declines their authorizations." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:example "First Bay Bank" ;
    pay:id_rule "iss:{issuer_id}" ;
    pay:lives_in "graph" ;
    pay:owner "core" .

<https://ontology.example.com/payments/MonitoringProgram#mastercard_ecp> a owl:NamedIndividual,
        pay:MonitoringProgram ;
    rdfs:label "mastercard_ecp" ;
    skos:definition "Mastercard's Excessive Chargeback Program." .

<https://ontology.example.com/payments/MonitoringProgram#mastercard_efm> a owl:NamedIndividual,
        pay:MonitoringProgram ;
    rdfs:label "mastercard_efm" ;
    skos:definition "Mastercard's Excessive Fraud Merchant program." .

<https://ontology.example.com/payments/MonitoringProgram#vamp> a owl:NamedIndividual,
        pay:MonitoringProgram ;
    rdfs:label "vamp" ;
    skos:definition "Visa Acquirer Monitoring Program, counting fraud reports and disputes." .

<https://ontology.example.com/payments/MonitoringTier#ecm> a owl:NamedIndividual,
        pay:MonitoringTier ;
    rdfs:label "ecm" ;
    skos:definition "Mastercard's Excessive Chargeback Merchant, the lower ECP tier." .

<https://ontology.example.com/payments/MonitoringTier#excessive> a owl:NamedIndividual,
        pay:MonitoringTier ;
    rdfs:label "excessive" ;
    skos:definition "VAMP's merchant tier." .

<https://ontology.example.com/payments/MonitoringTier#hecm> a owl:NamedIndividual,
        pay:MonitoringTier ;
    rdfs:label "hecm" ;
    skos:definition "Mastercard's High Excessive Chargeback Merchant, the higher ECP tier." .

pay:Party a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Party" ;
    rdfs:subClassOf [ owl:unionOf ( pay:Organization pay:Person ) ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:name ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:id ] ;
    skos:closeMatch cmns-pts:Party ;
    skos:definition "A person or organization that takes part in payments." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:lives_in "graph" ;
    pay:owner "core" .

pay:Settlement a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Settlement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[A-Z]{3}$" ] ) ] ;
            owl:onProperty pay:currency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:currency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:amount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:settled_at ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pay:settles ],
        pay:PaymentEvent ;
    skos:closeMatch fibo-fbc-fi-stl:SettlementEvent ;
    skos:definition "Funds moving between the banks for a batch of captures." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:id_rule "stl:{settlement_id}" ;
    pay:lives_in "warehouse" ;
    pay:owner "settlement" .

<https://ontology.example.com/payments/StandingInstruction#installment> a owl:NamedIndividual,
        pay:StandingInstruction ;
    rdfs:label "installment" ;
    skos:definition "A set number of payments for one purchase." .

<https://ontology.example.com/payments/StandingInstruction#recurring> a owl:NamedIndividual,
        pay:StandingInstruction ;
    rdfs:label "recurring" ;
    skos:definition "Regular charges, such as a subscription." .

<https://ontology.example.com/payments/StandingInstruction#unscheduled> a owl:NamedIndividual,
        pay:StandingInstruction ;
    rdfs:label "unscheduled" ;
    skos:definition "Charges at no fixed time, such as a top-up when a balance runs low." .

pay:VisaReasonCode a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "VisaReasonCode" ;
    owl:oneOf ( pay:visa-10.4 pay:visa-13.1 ) ;
    skos:definition "Visa dispute reason codes. Each is loaded as a ReasonCode node." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    linkml:permissible_values pay:visa-10.4,
        pay:visa-13.1 .

pay:mcc a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "mcc" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^\\d{4}$" ] ) ] ;
    skos:closeMatch fibo-be-fct-fct:MerchantCategoryCode ;
    skos:definition "Merchant category code, from ISO 18245." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:month a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "month" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^\\d{4}-\\d{2}$" ] ) ] ;
    skos:definition "The month a notice covers, as YYYY-MM." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:token_requestor a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "token_requestor" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^\\d{11}$" ] ) ] ;
    skos:definition "The Token Requestor ID of the wallet or merchant a network token was issued to: 11 digits, assigned under EMVCo's payment tokenisation." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:visa-10.4 a owl:NamedIndividual,
        pay:VisaReasonCode ;
    rdfs:label "10.4" ;
    skos:definition "Other Fraud: Card-Absent Environment" .

pay:visa-13.1 a owl:NamedIndividual,
        pay:VisaReasonCode ;
    rdfs:label "13.1" ;
    skos:definition "Merchandise/Services Not Received" .

fibo-loan-spc-crd:MastercardNetwork a owl:NamedIndividual,
        pay:CardNetwork ;
    rdfs:label "mastercard" .

fibo-loan-spc-crd:VisaNetwork a owl:NamedIndividual,
        pay:CardNetwork ;
    rdfs:label "visa" .

pay:CardNetwork a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "CardNetwork" ;
    owl:oneOf ( fibo-loan-spc-crd:VisaNetwork fibo-loan-spc-crd:MastercardNetwork ) ;
    skos:closeMatch fibo-loan-spc-crd:CreditCardNetwork ;
    skos:definition "Card networks whose rules the ontology covers." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    linkml:permissible_values fibo-loan-spc-crd:MastercardNetwork,
        fibo-loan-spc-crd:VisaNetwork .

pay:Channel a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "Channel" ;
    owl:oneOf ( <https://ontology.example.com/payments/Channel#card_present> <https://ontology.example.com/payments/Channel#card_not_present> ) ;
    skos:definition "How the card took part in a payment." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    linkml:permissible_values <https://ontology.example.com/payments/Channel#card_not_present>,
        <https://ontology.example.com/payments/Channel#card_present> .

pay:DisputeSide a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "DisputeSide" ;
    owl:oneOf ( <https://ontology.example.com/payments/DisputeSide#issuer> <https://ontology.example.com/payments/DisputeSide#acquirer> ) ;
    skos:definition "The two sides of a card dispute. Each bank stands in for its customer." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    linkml:permissible_values <https://ontology.example.com/payments/DisputeSide#acquirer>,
        <https://ontology.example.com/payments/DisputeSide#issuer> .

pay:FeeType a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "FeeType" ;
    owl:oneOf ( <https://ontology.example.com/payments/FeeType#interchange> <https://ontology.example.com/payments/FeeType#network_fee> ) ;
    skos:definition "What kind of fee a program sets." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    linkml:permissible_values <https://ontology.example.com/payments/FeeType#interchange>,
        <https://ontology.example.com/payments/FeeType#network_fee> .

pay:Initiator a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "Initiator" ;
    owl:oneOf ( <https://ontology.example.com/payments/Initiator#cardholder> <https://ontology.example.com/payments/Initiator#merchant> ) ;
    skos:definition "Who started a payment, under the networks' stored-credential rules." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    linkml:permissible_values <https://ontology.example.com/payments/Initiator#cardholder>,
        <https://ontology.example.com/payments/Initiator#merchant> .

pay:code a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "code" ;
    skos:definition "The code as the network or issuer writes it." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:network a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "network" ;
    rdfs:range pay:CardNetwork ;
    skos:definition "The card network whose rules apply." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:opened_at a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "opened_at" ;
    rdfs:range linkml:Datetime ;
    skos:definition "When the dispute step began." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:Credential a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "Credential" ;
    owl:oneOf ( <https://ontology.example.com/payments/Credential#pan> <https://ontology.example.com/payments/Credential#card_on_file_token> <https://ontology.example.com/payments/Credential#wallet_token> ) ;
    skos:definition "What stood in for the card number in an authorization." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    linkml:permissible_values <https://ontology.example.com/payments/Credential#card_on_file_token>,
        <https://ontology.example.com/payments/Credential#pan>,
        <https://ontology.example.com/payments/Credential#wallet_token> .

pay:Decider a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "Decider" ;
    owl:oneOf ( <https://ontology.example.com/payments/Decider#issuer> <https://ontology.example.com/payments/Decider#network_stand_in> <https://ontology.example.com/payments/Decider#processor_stand_in> ) ;
    skos:definition "Who answered an authorization." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    linkml:permissible_values <https://ontology.example.com/payments/Decider#issuer>,
        <https://ontology.example.com/payments/Decider#network_stand_in>,
        <https://ontology.example.com/payments/Decider#processor_stand_in> .

pay:DocumentKind a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "DocumentKind" ;
    owl:oneOf ( <https://ontology.example.com/payments/DocumentKind#network_rules> <https://ontology.example.com/payments/DocumentKind#runbook> <https://ontology.example.com/payments/DocumentKind#evidence> ) ;
    skos:definition "Kinds of document the platform indexes." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    linkml:permissible_values <https://ontology.example.com/payments/DocumentKind#evidence>,
        <https://ontology.example.com/payments/DocumentKind#network_rules>,
        <https://ontology.example.com/payments/DocumentKind#runbook> .

pay:FundingSource a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "FundingSource" ;
    owl:oneOf ( <https://ontology.example.com/payments/FundingSource#credit> <https://ontology.example.com/payments/FundingSource#debit> <https://ontology.example.com/payments/FundingSource#prepaid> ) ;
    skos:definition "Where the money behind a card comes from, as networks' BIN tables report it." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    linkml:permissible_values <https://ontology.example.com/payments/FundingSource#credit>,
        <https://ontology.example.com/payments/FundingSource#debit>,
        <https://ontology.example.com/payments/FundingSource#prepaid> .

pay:Merchant a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Merchant" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:acquired_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:mcc ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^\\d{4}$" ] ) ] ;
            owl:onProperty pay:mcc ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:country ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[A-Z]{2}$" ] ) ] ;
            owl:onProperty pay:country ],
        pay:PartyRole ;
    skos:altLabel "merchant outlet",
        "store" ;
    skos:closeMatch fibo-be-fct-fct:Merchant ;
    skos:definition "A business that accepts cards, as its acquirer knows it." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:example "m:88213, Harbor Grill #4, MCC 5812" ;
    pay:id_rule "m:{merchant_id}" ;
    pay:lives_in "graph" ;
    pay:owner "core" .

pay:MonitoringProgram a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "MonitoringProgram" ;
    owl:oneOf ( <https://ontology.example.com/payments/MonitoringProgram#vamp> <https://ontology.example.com/payments/MonitoringProgram#mastercard_ecp> <https://ontology.example.com/payments/MonitoringProgram#mastercard_efm> ) ;
    skos:definition "Network programs that monitor merchants' disputes and fraud." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    linkml:permissible_values <https://ontology.example.com/payments/MonitoringProgram#mastercard_ecp>,
        <https://ontology.example.com/payments/MonitoringProgram#mastercard_efm>,
        <https://ontology.example.com/payments/MonitoringProgram#vamp> .

pay:MonitoringTier a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "MonitoringTier" ;
    owl:oneOf ( <https://ontology.example.com/payments/MonitoringTier#excessive> <https://ontology.example.com/payments/MonitoringTier#ecm> <https://ontology.example.com/payments/MonitoringTier#hecm> ) ;
    skos:definition "The tier a merchant is identified in, where a program has tiers." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    linkml:permissible_values <https://ontology.example.com/payments/MonitoringTier#ecm>,
        <https://ontology.example.com/payments/MonitoringTier#excessive>,
        <https://ontology.example.com/payments/MonitoringTier#hecm> .

pay:StandingInstruction a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "StandingInstruction" ;
    owl:oneOf ( <https://ontology.example.com/payments/StandingInstruction#recurring> <https://ontology.example.com/payments/StandingInstruction#installment> <https://ontology.example.com/payments/StandingInstruction#unscheduled> ) ;
    skos:definition "The agreement a merchant-initiated payment follows." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    linkml:permissible_values <https://ontology.example.com/payments/StandingInstruction#installment>,
        <https://ontology.example.com/payments/StandingInstruction#recurring>,
        <https://ontology.example.com/payments/StandingInstruction#unscheduled> .

pay:country a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "country" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[A-Z]{2}$" ] ) ] ;
    skos:definition "A country, as an ISO 3166-1 alpha-2 code such as US: where a merchant trades, or where a BIN range is licensed." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:disputes a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "disputes" ;
    rdfs:range pay:Capture ;
    skos:definition "Links a dispute event to the capture it contests." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:name a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "name" ;
    skos:definition "What people call it." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:Authorization a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Authorization" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[A-Z]{3}$" ] ) ] ;
            owl:onProperty pay:currency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:currency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:authorization_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:from_device ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:standing_instruction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:decided_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:approved_amount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:increments ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:initiated_by ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:has_response ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:with_card ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:channel ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:amount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:credential ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^\\d{11}$" ] ) ] ;
            owl:onProperty pay:token_requestor ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:authenticated_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:authorized_at ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:at_merchant ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:token_requestor ],
        pay:PaymentEvent ;
    skos:altLabel "approval",
        "auth" ;
    skos:closeMatch iso20022:cain.001.001.05 ;
    skos:definition "The issuer's approval or decline of a payment request." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:example "auth:5521, Aug 3, $42.50, card not present" ;
    pay:id_rule "auth:{authorization_id}" ;
    pay:lives_in "warehouse" ;
    pay:owner "authorization" .

pay:AuthorizationType a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "AuthorizationType" ;
    owl:oneOf ( <https://ontology.example.com/payments/AuthorizationType#final> <https://ontology.example.com/payments/AuthorizationType#estimated> <https://ontology.example.com/payments/AuthorizationType#incremental> <https://ontology.example.com/payments/AuthorizationType#undefined> ) ;
    skos:definition "What an authorization's amount means. Visa names estimated and incremental authorizations; Mastercard names preauthorizations, undefined and final authorizations." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    linkml:permissible_values <https://ontology.example.com/payments/AuthorizationType#estimated>,
        <https://ontology.example.com/payments/AuthorizationType#final>,
        <https://ontology.example.com/payments/AuthorizationType#incremental>,
        <https://ontology.example.com/payments/AuthorizationType#undefined> .

pay:DisputeCategory a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "DisputeCategory" ;
    owl:oneOf ( <https://ontology.example.com/payments/DisputeCategory#fraud> <https://ontology.example.com/payments/DisputeCategory#authorization> <https://ontology.example.com/payments/DisputeCategory#processing_error> <https://ontology.example.com/payments/DisputeCategory#consumer_dispute> ) ;
    skos:definition "The four kinds of dispute both networks group their reason codes into. Visa numbers them 10 to 13; Mastercard calls processing errors point-of-interaction errors." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    linkml:permissible_values <https://ontology.example.com/payments/DisputeCategory#authorization>,
        <https://ontology.example.com/payments/DisputeCategory#consumer_dispute>,
        <https://ontology.example.com/payments/DisputeCategory#fraud>,
        <https://ontology.example.com/payments/DisputeCategory#processing_error> .

pay:DisputeClosure a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "DisputeClosure" ;
    owl:oneOf ( <https://ontology.example.com/payments/DisputeClosure#accepted> <https://ontology.example.com/payments/DisputeClosure#withdrawn> <https://ontology.example.com/payments/DisputeClosure#ruled> <https://ontology.example.com/payments/DisputeClosure#timed_out> ) ;
    skos:definition "How a dispute ended." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    linkml:permissible_values <https://ontology.example.com/payments/DisputeClosure#accepted>,
        <https://ontology.example.com/payments/DisputeClosure#ruled>,
        <https://ontology.example.com/payments/DisputeClosure#timed_out>,
        <https://ontology.example.com/payments/DisputeClosure#withdrawn> .

pay:responds_to a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "responds_to" ;
    rdfs:range pay:DisputeEvent ;
    skos:definition "The earlier dispute event this one answers." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:AuthenticationResult a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "AuthenticationResult" ;
    owl:oneOf ( <https://ontology.example.com/payments/AuthenticationResult#authenticated> <https://ontology.example.com/payments/AuthenticationResult#attempted> <https://ontology.example.com/payments/AuthenticationResult#not_authenticated> <https://ontology.example.com/payments/AuthenticationResult#rejected> <https://ontology.example.com/payments/AuthenticationResult#unavailable> ) ;
    skos:definition "How a cardholder authentication ended, following EMV 3-D Secure's final transaction status." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    linkml:permissible_values <https://ontology.example.com/payments/AuthenticationResult#attempted>,
        <https://ontology.example.com/payments/AuthenticationResult#authenticated>,
        <https://ontology.example.com/payments/AuthenticationResult#not_authenticated>,
        <https://ontology.example.com/payments/AuthenticationResult#rejected>,
        <https://ontology.example.com/payments/AuthenticationResult#unavailable> .

pay:Capture a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Capture" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:currency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:qualifies_for ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[A-Z]{3}$" ] ) ] ;
            owl:onProperty pay:currency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:in_batch ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:captured_at ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:interchange_fee ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:amount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:conversion_rate ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:captures ],
        pay:PaymentEvent ;
    skos:altLabel "clearing",
        "presentment" ;
    skos:closeMatch iso20022:cain.003.001.05 ;
    skos:definition "The merchant claiming the funds an authorization approved." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:example "cap:7731, Aug 4, $42.50" ;
    pay:id_rule "cap:{capture_id}" ;
    pay:lives_in "warehouse" ;
    pay:owner "settlement" .

pay:PartyRole a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "PartyRole" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:id ],
        [ owl:unionOf ( pay:Acquirer pay:Cardholder pay:Issuer pay:Merchant ) ] ;
    skos:closeMatch cmns-pts:PartyRole ;
    skos:definition "A role a party plays, such as issuer or merchant. Roles keep one bank from turning into two nodes." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:lives_in "graph" ;
    pay:owner "core" .

pay:DisputeEvent a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "DisputeEvent" ;
    rdfs:subClassOf [ owl:unionOf ( pay:Arbitration pay:Chargeback pay:DisputeOutcome pay:PreArbitration pay:Representment pay:RetrievalRequest ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[A-Z]{3}$" ] ) ] ;
            owl:onProperty pay:currency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:responds_to ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:currency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:disputes ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:opened_at ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:amount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pay:respond_by ],
        pay:PaymentEvent ;
    skos:definition "A step in a dispute over a captured transaction. Each step carries the amount in dispute and, while it waits for an answer, the date the other side must respond by." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:lives_in "graph" ;
    pay:owner "disputes" .

pay:PaymentEvent a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "PaymentEvent" ;
    rdfs:subClassOf [ owl:unionOf ( pay:Adjustment pay:Authentication pay:Authorization pay:Capture pay:DisputeEvent pay:FraudReport pay:Payout pay:Refund pay:Reversal pay:Settlement ) ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty pay:id ] ;
    skos:definition "Something that happened to a payment, at a time. Each step is its own event, instead of a status field that keeps being overwritten." ;
    skos:inScheme <https://ontology.example.com/payments> ;
    pay:lives_in "graph" ;
    pay:owner "core" .

pay:amount a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "amount" ;
    rdfs:range linkml:Decimal ;
    skos:definition "The amount, in the transaction currency." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:id a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "id" ;
    skos:definition "The one ID used in Neptune, OpenSearch and Snowflake." ;
    skos:inScheme <https://ontology.example.com/payments> .

pay:currency a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "currency" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[A-Z]{3}$" ] ) ] ;
    skos:definition "The transaction currency, as an ISO 4217 alphabetic code such as USD." ;
    skos:inScheme <https://ontology.example.com/payments> .

<https://ontology.example.com/payments> a owl:Ontology ;
    rdfs:label "payments" ;
    dcterms:title "Payments ontology (illustrative draft)" ;
    pav:version "1.12.0" ;
    pay:commons_release "https://www.omg.org/spec/Commons/20250801/" ;
    pay:fibo_release "https://spec.edmcouncil.org/fibo/ontology/master/2026Q2/" .

