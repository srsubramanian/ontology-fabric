@prefix fibo-loan-spc-crd: <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansSpecific/CardAccounts/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pay: <https://ontology.example.com/payments/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pay:Adjustment a sh:NodeShape ;
    rdfs:comment "A correction to a capture after it cleared, such as a changed amount, made under the network's rules." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description "The amount, in the transaction currency." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:amount ],
        [ sh:datatype xsd:string ;
            sh:description "The transaction currency, as an ISO 4217 alphabetic code such as USD." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pay:currency ;
            sh:pattern "^[A-Z]{3}$" ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the adjustment was made." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:adjusted_at ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pay:id ],
        [ sh:class pay:Capture ;
            sh:description "The capture an adjustment corrects." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path pay:adjusts ] ;
    sh:targetClass pay:Adjustment .

pay:Arbitration a sh:NodeShape ;
    rdfs:comment "Either side asking the card network to decide a dispute that pre-arbitration didn't settle. The network's ruling is binding." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description "The amount, in the transaction currency." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pay:amount ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the dispute step began." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:opened_at ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the other side must answer this step by, under the network's rules for the stage. Missing it decides the dispute against that side." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:respond_by ],
        [ sh:class pay:DisputeEvent ;
            sh:description "The earlier dispute event this one answers." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path pay:responds_to ],
        [ sh:class pay:ReasonCode ;
            sh:description "The network reason codes behind a dispute." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path pay:has_reason ],
        [ sh:datatype xsd:string ;
            sh:description "The transaction currency, as an ISO 4217 alphabetic code such as USD." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pay:currency ;
            sh:pattern "^[A-Z]{3}$" ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path pay:id ],
        [ sh:class pay:Capture ;
            sh:description "Links a dispute event to the capture it contests." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path pay:disputes ] ;
    sh:targetClass pay:Arbitration .

pay:Chargeback a sh:NodeShape ;
    rdfs:label "Chargeback" ;
    rdfs:comment "A dispute event in which the issuer, through the card network, reverses all or part of a captured transaction for the cardholder." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class pay:DisputeEvent ;
            sh:description "The earlier dispute event this one answers." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path pay:responds_to ],
        [ sh:datatype xsd:decimal ;
            sh:description "The amount, in the transaction currency." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pay:amount ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the other side must answer this step by, under the network's rules for the stage. Missing it decides the dispute against that side." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:respond_by ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the dispute step began." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:opened_at ],
        [ sh:class pay:ReasonCode ;
            sh:description "The network reason codes behind a dispute." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path pay:has_reason ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path pay:id ],
        [ sh:datatype xsd:string ;
            sh:description "The transaction currency, as an ISO 4217 alphabetic code such as USD." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pay:currency ;
            sh:pattern "^[A-Z]{3}$" ],
        [ sh:class pay:Capture ;
            sh:description "Links a dispute event to the capture it contests." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path pay:disputes ] ;
    sh:targetClass pay:Chargeback .

pay:Chunk a sh:NodeShape ;
    rdfs:comment "A passage of a document. Its text and embedding live in OpenSearch; the stub in Neptune links it to the entities it mentions." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Anything a chunk names, such as a merchant, a reason code or a dispute, so its text links to the graph." ;
            sh:order 2 ;
            sh:path pay:mentions ],
        [ sh:class pay:Document ;
            sh:description "The document a chunk comes from." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path pay:part_of ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:id ] ;
    sh:targetClass pay:Chunk .

pay:DisputeOutcome a sh:NodeShape ;
    rdfs:comment "The event that closes a dispute: which side won, how it ended, and the amount that finally went back to the cardholder. It answers the dispute's last step, and links to the disputed capture, as the chargeback does." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "When the dispute step began." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pay:opened_at ],
        [ sh:datatype xsd:decimal ;
            sh:description "The amount, in the transaction currency." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pay:amount ],
        [ sh:class pay:ReasonCode ;
            sh:description "The network reason codes behind a dispute." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path pay:has_reason ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the other side must answer this step by, under the network's rules for the stage. Missing it decides the dispute against that side." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pay:respond_by ],
        [ sh:class pay:DisputeEvent ;
            sh:description "The earlier dispute event this one answers." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path pay:responds_to ],
        [ sh:description "How a dispute ended." ;
            sh:in ( "accepted" "withdrawn" "ruled" "timed_out" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path pay:closure ],
        [ sh:description "The side a dispute ended in favor of." ;
            sh:in ( "issuer" "acquirer" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path pay:won_by ],
        [ sh:datatype xsd:string ;
            sh:description "The transaction currency, as an ISO 4217 alphabetic code such as USD." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pay:currency ;
            sh:pattern "^[A-Z]{3}$" ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path pay:id ],
        [ sh:class pay:Capture ;
            sh:description "Links a dispute event to the capture it contests." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path pay:disputes ] ;
    sh:targetClass pay:DisputeOutcome .

pay:FeeCollection a sh:NodeShape ;
    rdfs:comment "The network collecting fees from a member, an issuer or an acquirer, such as its monthly assessments." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description "The amount, in the transaction currency." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pay:amount ],
        [ sh:class pay:FeeProgram ;
            sh:description "The fee program a collection charges." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path pay:under ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the network collected the fees." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:collected_at ],
        [ sh:datatype xsd:string ;
            sh:description "The transaction currency, as an ISO 4217 alphabetic code such as USD." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pay:currency ;
            sh:pattern "^[A-Z]{3}$" ],
        [ sh:class pay:PartyRole ;
            sh:description "The member the fees were collected from, an issuer or an acquirer." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path pay:collected_from ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:id ] ;
    sh:targetClass pay:FeeCollection .

pay:FraudReport a sh:NodeShape ;
    rdfs:comment "An issuer reporting an authorization as fraud to the network." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "When the fraud was reported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:reported_at ],
        [ sh:class pay:Authorization ;
            sh:description "The authorization a fraud report is about." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path pay:reports ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pay:id ] ;
    sh:targetClass pay:FraudReport .

pay:MonitoringNotice a sh:NodeShape ;
    rdfs:comment "A card network identifying a merchant in one of its monitoring programs for a month, such as Visa's VAMP, with the tier and the ratio it measured." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The program's tier the merchant was identified in, where the program has tiers." ;
            sh:in ( "excessive" "ecm" "hecm" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path pay:tier ],
        [ sh:description "The network monitoring program." ;
            sh:in ( "vamp" "mastercard_ecp" "mastercard_efm" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path pay:program ],
        [ sh:datatype xsd:decimal ;
            sh:description "The ratio the program measured for the month, as a fraction (0.0165 is 1.65%)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pay:ratio ],
        [ sh:class pay:Merchant ;
            sh:description "The merchant a monitoring notice identifies." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path pay:identifies ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:id ],
        [ sh:datatype xsd:string ;
            sh:description "The month a notice covers, as YYYY-MM." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:month ;
            sh:pattern "^\\d{4}-\\d{2}$" ] ;
    sh:targetClass pay:MonitoringNotice .

pay:Organization a sh:NodeShape ;
    rdfs:comment "A company or institution. One bank is one Organization, however many roles it plays." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class pay:PartyRole ;
            sh:description "A party plays a role." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path pay:acts_as ],
        [ sh:datatype xsd:string ;
            sh:description "What people call it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:name ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:id ] ;
    sh:targetClass pay:Organization .

pay:Party a sh:NodeShape ;
    rdfs:comment "A person or organization that takes part in payments." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class pay:PartyRole ;
            sh:description "A party plays a role." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path pay:acts_as ],
        [ sh:datatype xsd:string ;
            sh:description "What people call it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:name ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:id ] ;
    sh:targetClass pay:Party .

pay:PaymentEvent a sh:NodeShape ;
    rdfs:comment "Something that happened to a payment, at a time. Each step is its own event, instead of a status field that keeps being overwritten." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type pay:adjusted_at pay:adjusts pay:amount pay:approved_amount pay:at_merchant pay:authenticated_at pay:authenticated_by pay:authentication_result pay:authorization_type pay:authorized_at pay:captured_at pay:captures pay:challenged pay:channel pay:closure pay:conversion_rate pay:credential pay:currency pay:decided_by pay:disputes pay:from_device pay:funds pay:has_evidence pay:has_reason pay:has_response pay:in_batch pay:increments pay:initiated_by pay:interchange_fee pay:opened_at pay:paid_at pay:qualifies_for pay:refunded_at pay:refunds pay:reported_at pay:reports pay:reserve_amount pay:respond_by pay:responds_to pay:reversed_at pay:reverses pay:settled_at pay:settles pay:standing_instruction pay:token_requestor pay:with_card pay:won_by ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:id ] ;
    sh:targetClass pay:PaymentEvent .

pay:Payout a sh:NodeShape ;
    rdfs:comment "The acquirer paying a merchant for its settled captures, less fees and any amount held back in reserve." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "When the acquirer paid the merchant." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:paid_at ],
        [ sh:datatype xsd:decimal ;
            sh:description "The amount, in the transaction currency." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:amount ],
        [ sh:datatype xsd:string ;
            sh:description "The transaction currency, as an ISO 4217 alphabetic code such as USD." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pay:currency ;
            sh:pattern "^[A-Z]{3}$" ],
        [ sh:class pay:Capture ;
            sh:description "The captures a payout pays the merchant for." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path pay:funds ],
        [ sh:datatype xsd:decimal ;
            sh:description "The amount held back from a payout into the merchant's reserve; negative when the acquirer releases reserve." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pay:reserve_amount ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pay:id ] ;
    sh:targetClass pay:Payout .

pay:Person a sh:NodeShape ;
    rdfs:comment "An individual, such as a cardholder." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class pay:PartyRole ;
            sh:description "A party plays a role." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path pay:acts_as ],
        [ sh:datatype xsd:string ;
            sh:description "What people call it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:name ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:id ] ;
    sh:targetClass pay:Person .

pay:PreArbitration a sh:NodeShape ;
    rdfs:comment "Issuer challenges the merchant's response before arbitration." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description "The amount, in the transaction currency." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pay:amount ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the dispute step began." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:opened_at ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the other side must answer this step by, under the network's rules for the stage. Missing it decides the dispute against that side." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:respond_by ],
        [ sh:class pay:DisputeEvent ;
            sh:description "The earlier dispute event this one answers." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path pay:responds_to ],
        [ sh:class pay:ReasonCode ;
            sh:description "The network reason codes behind a dispute." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path pay:has_reason ],
        [ sh:datatype xsd:string ;
            sh:description "The transaction currency, as an ISO 4217 alphabetic code such as USD." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pay:currency ;
            sh:pattern "^[A-Z]{3}$" ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path pay:id ],
        [ sh:class pay:Capture ;
            sh:description "Links a dispute event to the capture it contests." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path pay:disputes ] ;
    sh:targetClass pay:PreArbitration .

pay:Reconciliation a sh:NodeShape ;
    rdfs:comment "A member checking its totals for a settlement against the network's, and recording any difference." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Whether the member's totals matched the network's." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pay:matched ],
        [ sh:datatype xsd:string ;
            sh:description "The transaction currency, as an ISO 4217 alphabetic code such as USD." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pay:currency ;
            sh:pattern "^[A-Z]{3}$" ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the totals were checked." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:reconciled_at ],
        [ sh:datatype xsd:decimal ;
            sh:description "The amount by which the totals differed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pay:difference ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:id ],
        [ sh:class pay:Settlement ;
            sh:description "The settlement whose totals were checked." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path pay:reconciles ] ;
    sh:targetClass pay:Reconciliation .

pay:Refund a sh:NodeShape ;
    rdfs:comment "The merchant returning all or part of a captured amount." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "When the refund was made." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:refunded_at ],
        [ sh:datatype xsd:decimal ;
            sh:description "The amount, in the transaction currency." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:amount ],
        [ sh:datatype xsd:string ;
            sh:description "The transaction currency, as an ISO 4217 alphabetic code such as USD." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pay:currency ;
            sh:pattern "^[A-Z]{3}$" ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pay:id ],
        [ sh:class pay:Capture ;
            sh:description "The capture a refund returns money from." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path pay:refunds ] ;
    sh:targetClass pay:Refund .

pay:Representment a sh:NodeShape ;
    rdfs:comment "The merchant's response to a chargeback, with its evidence." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "When the other side must answer this step by, under the network's rules for the stage. Missing it decides the dispute against that side." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pay:respond_by ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the dispute step began." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:opened_at ],
        [ sh:class pay:DisputeEvent ;
            sh:description "The earlier dispute event this one answers." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path pay:responds_to ],
        [ sh:class pay:ReasonCode ;
            sh:description "The network reason codes behind a dispute." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path pay:has_reason ],
        [ sh:datatype xsd:decimal ;
            sh:description "The amount, in the transaction currency." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pay:amount ],
        [ sh:datatype xsd:string ;
            sh:description "The transaction currency, as an ISO 4217 alphabetic code such as USD." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pay:currency ;
            sh:pattern "^[A-Z]{3}$" ],
        [ sh:class pay:Document ;
            sh:description "Documents sent as evidence." ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path pay:has_evidence ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path pay:id ],
        [ sh:class pay:Capture ;
            sh:description "Links a dispute event to the capture it contests." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path pay:disputes ] ;
    sh:targetClass pay:Representment .

pay:RetrievalRequest a sh:NodeShape ;
    rdfs:comment "The issuer asking the acquirer for the original transaction details, often before it decides whether to dispute." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description "The amount, in the transaction currency." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pay:amount ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the dispute step began." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:opened_at ],
        [ sh:class pay:DisputeEvent ;
            sh:description "The earlier dispute event this one answers." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path pay:responds_to ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the other side must answer this step by, under the network's rules for the stage. Missing it decides the dispute against that side." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:respond_by ],
        [ sh:class pay:ReasonCode ;
            sh:description "The network reason codes behind a dispute." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path pay:has_reason ],
        [ sh:datatype xsd:string ;
            sh:description "The transaction currency, as an ISO 4217 alphabetic code such as USD." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pay:currency ;
            sh:pattern "^[A-Z]{3}$" ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path pay:id ],
        [ sh:class pay:Capture ;
            sh:description "Links a dispute event to the capture it contests." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path pay:disputes ] ;
    sh:targetClass pay:RetrievalRequest .

pay:Reversal a sh:NodeShape ;
    rdfs:comment "The acquirer cancelling all or part of an authorization, so the issuer releases the hold on the cardholder's funds." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description "The amount, in the transaction currency." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:amount ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the acquirer sent the reversal." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:reversed_at ],
        [ sh:datatype xsd:string ;
            sh:description "The transaction currency, as an ISO 4217 alphabetic code such as USD." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pay:currency ;
            sh:pattern "^[A-Z]{3}$" ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pay:id ],
        [ sh:class pay:Authorization ;
            sh:description "The authorization a reversal cancels." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path pay:reverses ] ;
    sh:targetClass pay:Reversal .

linkml:Any a sh:NodeShape ;
    rdfs:comment "Any entity with an ID. A relationship whose range is Any can point at a node of any class, as a chunk's MENTIONS does. Not a node itself." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass linkml:Any .

pay:Acquirer a sh:NodeShape ;
    rdfs:comment "The bank that signs up merchants and claims funds for them." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:id ] ;
    sh:targetClass pay:Acquirer .

pay:Authentication a sh:NodeShape ;
    rdfs:comment "The issuer checking that the cardholder is who they say, before an authorization, such as a 3-D Secure attempt." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Whether the issuer challenged the cardholder, such as with a one-time code, rather than letting the payment through without friction." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pay:challenged ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the cardholder was authenticated." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:authenticated_at ],
        [ sh:description "How an authentication ended, as EMV 3-D Secure's final transaction status reports it." ;
            sh:in ( "authenticated" "attempted" "not_authenticated" "rejected" "unavailable" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path pay:authentication_result ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pay:id ] ;
    sh:targetClass pay:Authentication .

pay:BinRange a sh:NodeShape ;
    rdfs:comment "The range of card numbers a bank issues from. A node rather than a string, so authorizations can be grouped by it." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Where the money behind the cards in a BIN range comes from, as the network's BIN table reports it." ;
            sh:in ( "credit" "debit" "prepaid" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path pay:funding_source ],
        [ sh:class pay:Issuer ;
            sh:description "The issuer a BIN range belongs to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path pay:assigned_to ],
        [ sh:datatype xsd:string ;
            sh:description "The leading digits every card in the range shares." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:prefix ],
        [ sh:datatype xsd:string ;
            sh:description "A country, as an ISO 3166-1 alpha-2 code such as US: where a merchant trades, or where a BIN range is licensed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pay:country ;
            sh:pattern "^[A-Z]{2}$" ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:id ] ;
    sh:targetClass pay:BinRange .

pay:Card a sh:NodeShape ;
    rdfs:comment "A payment card, identified by a token rather than its number." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class pay:Cardholder ;
            sh:description "Who a card is issued to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path pay:held_by ],
        [ sh:description "The card network whose rules apply." ;
            sh:in ( fibo-loan-spc-crd:VisaNetwork fibo-loan-spc-crd:MastercardNetwork ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path pay:network ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:id ],
        [ sh:class pay:BinRange ;
            sh:description "The BIN range a card's number falls in." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path pay:in_bin_range ] ;
    sh:targetClass pay:Card .

pay:Cardholder a sh:NodeShape ;
    rdfs:comment "The person a card is issued to." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:id ] ;
    sh:targetClass pay:Cardholder .

pay:ClearingBatch a sh:NodeShape ;
    rdfs:comment "A batch of captures sent for clearing and settlement in one exchange, such as an acquirer's clearing file." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "When the batch was sent." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:sent_at ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:id ] ;
    sh:targetClass pay:ClearingBatch .

pay:Device a sh:NodeShape ;
    rdfs:comment "A phone, browser or terminal an authorization came from." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:id ],
        [ sh:class pay:Merchant ;
            sh:description "A summary edge, rebuilt daily from Snowflake: the device made authorizations at the merchant. It carries auths, first_seen and last_seen, so risk walks don't need every authorization in the graph (decision 2)." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path pay:seen_at ] ;
    sh:targetClass pay:Device .

pay:Issuer a sh:NodeShape ;
    rdfs:comment "The bank that issues cards and approves or declines their authorizations." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:id ] ;
    sh:targetClass pay:Issuer .

pay:ResponseCode a sh:NodeShape ;
    rdfs:comment "The issuer's answer code on an authorization, such as approved or declined." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The code as the network or issuer writes it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:code ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:id ] ;
    sh:targetClass pay:ResponseCode .

pay:Settlement a sh:NodeShape ;
    rdfs:comment "Funds moving between the banks for a batch of captures." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description "The amount, in the transaction currency." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:amount ],
        [ sh:datatype xsd:string ;
            sh:description "The transaction currency, as an ISO 4217 alphabetic code such as USD." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pay:currency ;
            sh:pattern "^[A-Z]{3}$" ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the funds moved." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:settled_at ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pay:id ],
        [ sh:class pay:Capture ;
            sh:description "The captures a settlement pays out." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path pay:settles ] ;
    sh:targetClass pay:Settlement .

pay:Document a sh:NodeShape ;
    rdfs:comment "A network rule book, runbook or piece of evidence. Its text lives in search; Neptune keeps a stub." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "What sort of document it is." ;
            sh:in ( "network_rules" "runbook" "evidence" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path pay:kind ],
        [ sh:datatype xsd:string ;
            sh:description "What people call it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:name ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:id ] ;
    sh:targetClass pay:Document .

pay:FeeProgram a sh:NodeShape ;
    rdfs:comment "A fee a network publishes, such as an interchange category a capture qualifies for. A node, so captures and the fees charged meet at one place; the amounts stay in Snowflake (decision 2)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The card network whose rules apply." ;
            sh:in ( fibo-loan-spc-crd:VisaNetwork fibo-loan-spc-crd:MastercardNetwork ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path pay:network ],
        [ sh:description "What kind of fee a program sets." ;
            sh:in ( "interchange" "network_fee" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path pay:fee_type ],
        [ sh:datatype xsd:string ;
            sh:description "The code as the network or issuer writes it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pay:code ],
        [ sh:datatype xsd:string ;
            sh:description "What people call it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pay:name ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:id ] ;
    sh:targetClass pay:FeeProgram .

pay:Merchant a sh:NodeShape ;
    rdfs:comment "A business that accepts cards, as its acquirer knows it." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A country, as an ISO 3166-1 alpha-2 code such as US: where a merchant trades, or where a BIN range is licensed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pay:country ;
            sh:pattern "^[A-Z]{2}$" ],
        [ sh:class pay:Acquirer ;
            sh:description "A merchant's acquiring bank." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path pay:acquired_by ],
        [ sh:datatype xsd:string ;
            sh:description "What people call it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:name ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pay:id ],
        [ sh:datatype xsd:string ;
            sh:description "Merchant category code, from ISO 18245." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:mcc ;
            sh:pattern "^\\d{4}$" ] ;
    sh:targetClass pay:Merchant .

pay:Authorization a sh:NodeShape ;
    rdfs:comment "The issuer's approval or decline of a payment request." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The Token Requestor ID of the wallet or merchant a network token was issued to: 11 digits, assigned under EMVCo's payment tokenisation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path pay:token_requestor ;
            sh:pattern "^\\d{11}$" ],
        [ sh:description "Who answered the authorization: the issuer, or stand-in processing answering for an issuer that couldn't." ;
            sh:in ( "issuer" "network_stand_in" "processor_stand_in" ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path pay:decided_by ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the issuer answered." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:authorized_at ],
        [ sh:datatype xsd:decimal ;
            sh:description "The amount, in the transaction currency." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:amount ],
        [ sh:class pay:Device ;
            sh:description "The device an authorization came from." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path pay:from_device ],
        [ sh:class pay:Authorization ;
            sh:description "The earlier authorization an incremental authorization adds to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path pay:increments ],
        [ sh:description "Whether an authorization's amount is final, an estimate, or an increase to an earlier estimate." ;
            sh:in ( "final" "estimated" "incremental" "undefined" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path pay:authorization_type ],
        [ sh:class pay:Authentication ;
            sh:description "The authentication an authorization relied on." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path pay:authenticated_by ],
        [ sh:description "What stood in for the card number in an authorization." ;
            sh:in ( "pan" "card_on_file_token" "wallet_token" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path pay:credential ],
        [ sh:description "The agreement a merchant-initiated payment follows, such as a subscription." ;
            sh:in ( "recurring" "installment" "unscheduled" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path pay:standing_instruction ],
        [ sh:description "Who started the payment, under the networks' stored-credential rules: the cardholder, or the merchant using a card it keeps on file." ;
            sh:in ( "cardholder" "merchant" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path pay:initiated_by ],
        [ sh:datatype xsd:decimal ;
            sh:description "The amount the issuer approved, when less than the amount requested: a partial approval." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pay:approved_amount ],
        [ sh:description "Whether the card was present." ;
            sh:in ( "card_present" "card_not_present" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path pay:channel ],
        [ sh:datatype xsd:string ;
            sh:description "The transaction currency, as an ISO 4217 alphabetic code such as USD." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pay:currency ;
            sh:pattern "^[A-Z]{3}$" ],
        [ sh:class pay:Card ;
            sh:description "The card an authorization used." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path pay:with_card ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path pay:id ],
        [ sh:class pay:Merchant ;
            sh:description "Where an authorization was requested." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path pay:at_merchant ],
        [ sh:class pay:ResponseCode ;
            sh:description "The issuer's answer to an authorization." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path pay:has_response ] ;
    sh:targetClass pay:Authorization .

pay:PartyRole a sh:NodeShape ;
    rdfs:comment "A role a party plays, such as issuer or merchant. Roles keep one bank from turning into two nodes." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type pay:acquired_by pay:country pay:mcc pay:name ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:id ] ;
    sh:targetClass pay:PartyRole .

pay:DisputeEvent a sh:NodeShape ;
    rdfs:comment "A step in a dispute over a captured transaction. Each step carries the amount in dispute and, while it waits for an answer, the date the other side must respond by." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type pay:closure pay:has_evidence pay:won_by ) ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description "The amount, in the transaction currency." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pay:amount ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the dispute step began." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:opened_at ],
        [ sh:class pay:DisputeEvent ;
            sh:description "The earlier dispute event this one answers." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path pay:responds_to ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the other side must answer this step by, under the network's rules for the stage. Missing it decides the dispute against that side." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:respond_by ],
        [ sh:class pay:ReasonCode ;
            sh:description "The network reason codes behind a dispute." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path pay:has_reason ],
        [ sh:datatype xsd:string ;
            sh:description "The transaction currency, as an ISO 4217 alphabetic code such as USD." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pay:currency ;
            sh:pattern "^[A-Z]{3}$" ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path pay:id ],
        [ sh:class pay:Capture ;
            sh:description "Links a dispute event to the capture it contests." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path pay:disputes ] ;
    sh:targetClass pay:DisputeEvent .

pay:ReasonCode a sh:NodeShape ;
    rdfs:comment "A network's reason for a dispute. A node, so chargebacks and the documents that explain the code meet at one place." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The kind of dispute a reason code stands for, the same across networks, so chargebacks can be grouped without knowing each network's codes." ;
            sh:in ( "fraud" "authorization" "processing_error" "consumer_dispute" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path pay:category ],
        [ sh:description "The card network whose rules apply." ;
            sh:in ( fibo-loan-spc-crd:VisaNetwork fibo-loan-spc-crd:MastercardNetwork ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path pay:network ],
        [ sh:datatype xsd:string ;
            sh:description "The code as the network or issuer writes it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pay:code ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:id ] ;
    sh:targetClass pay:ReasonCode .

pay:Capture a sh:NodeShape ;
    rdfs:comment "The merchant claiming the funds an authorization approved." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description "The interchange the capture paid, in its settlement's currency. The amount stays in Snowflake; the program it qualified for is a node." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pay:interchange_fee ],
        [ sh:datatype xsd:decimal ;
            sh:description "The amount, in the transaction currency." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pay:amount ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the merchant claimed the funds." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pay:captured_at ],
        [ sh:datatype xsd:string ;
            sh:description "The transaction currency, as an ISO 4217 alphabetic code such as USD." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pay:currency ;
            sh:pattern "^[A-Z]{3}$" ],
        [ sh:class pay:FeeProgram ;
            sh:description "The interchange program a capture qualified for." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path pay:qualifies_for ],
        [ sh:datatype xsd:decimal ;
            sh:description "The rate that converted a capture's amount into its settlement's currency, when the two differ." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pay:conversion_rate ],
        [ sh:class pay:Authorization ;
            sh:description "The authorization a capture claims funds for." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path pay:captures ],
        [ sh:datatype xsd:string ;
            sh:description "The one ID used in Neptune, OpenSearch and Snowflake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path pay:id ],
        [ sh:class pay:ClearingBatch ;
            sh:description "The batch that carried a capture to the network." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path pay:in_batch ] ;
    sh:targetClass pay:Capture .

